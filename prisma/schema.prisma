generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum GuideCategory {
  PRACTICE
  EXAM
}

enum CourseTrack {
  SCRATCH
  PYTHON
  INFORMATICS
}

model User {
  id           String       @id @default(uuid())
  phone        String?      @unique
  email        String?      @unique
  name         String
  passwordHash String
  role         UserRole     @default(USER)
  isActive     Boolean      @default(true)
  stars        Int          @default(0)
  createdAt    DateTime     @default(now())
  enrollments  Enrollment[]
  projects     Project[]
  comments     Comment[]
  hearts       Heart[]
  votes        Vote[]
  submissions  Submission[]
  redemptions  Redemption[]
}

model Student {
  id         String        @id @default(uuid())
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  childName  String
  parentName String
  phone      String
  age        Int
  track      CourseTrack
  status     String        @default("ACTIVE")
  classId    String?
  class      CourseClass?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  invoices   TuitionInvoice[]

  @@index([childName])
  @@index([phone])
  @@index([track, status])
  @@index([classId])
}

model CourseClass {
  id        String      @id @default(uuid())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  name      String
  track     CourseTrack
  weekday   Int
  startsAt  String
  active    Boolean     @default(true)
  students  Student[]

  @@index([weekday, startsAt])
  @@index([active])
}

model TuitionInvoice {
  id          String           @id @default(uuid())
  number      String           @unique
  createdAt   DateTime         @default(now())
  description String
  amount      Int
  dueDate     DateTime?
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  payments    TuitionPayment[]

  @@index([createdAt])
  @@index([studentId, createdAt])
}

model TuitionPayment {
  id            String        @id @default(uuid())
  receiptNumber String        @unique
  receivedAt    DateTime      @default(now())
  amount        Int
  method        String
  note          String?
  invoiceId     String
  invoice       TuitionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([receivedAt])
  @@index([invoiceId, receivedAt])
}

model Enrollment {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  status     String   @default("NEW")
  isTrial    Boolean  @default(true)
  parentName String
  phone      String
  email      String?
  childName  String
  childAge   Int
  courseSlug String
  mode       String
  note       String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}

model Project {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  title       String
  description String?
  scratchUrl  String
  authorName  String
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  comments    Comment[]
  hearts      Heart[]
  votes       Vote[]

  @@index([createdAt])
  @@index([userId])
}

model Comment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  content   String
  projectId String
  userId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([userId])
}

model Heart {
  userId    String
  projectId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

model Vote {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
  projectId String
  month     String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([projectId, month])
}

model Submission {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  userId     String?
  courseSlug String
  lessonNo   Int
  authorName String?
  link       String?
  pythonCode String?   @db.Text
  note       String?
  feedback   String?
  bonusStars Int       @default(0)
  reviewedAt DateTime?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([userId, courseSlug, lessonNo])
  @@index([createdAt])
  @@index([reviewedAt])
}

model Redemption {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
  rewardId  String
  rewardName String
  cost      Int
  status    String   @default("PENDING")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
}

model GuideArticle {
  id          String   @id @default(uuid())
  category    GuideCategory
  title       String
  slug        String   @unique
  summary     String
  prompt      String
  imageUrl    String
  imageAlt    String
  blockCode   String
  algorithm   String[] @default([])
  explanation String
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, createdAt])
}

model AppSetting {
  key   String @id
  value String
}

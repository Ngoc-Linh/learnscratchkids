# Tài khoản quản trị khởi tạo bằng `npm run db:seed`.
ADMIN_PHONE="0342681138"
ADMIN_PASSWORD=""

# PostgreSQL do Neon (Vercel Marketplace) cung cấp.
# DATABASE_URL dùng kết nối pooled của Neon; DIRECT_URL dùng kết nối direct cho migrations.
DATABASE_URL=""
DIRECT_URL=""

# Bắt buộc khi chạy production; dùng secret ngẫu nhiên dài.
AUTH_SECRET=""

# Gửi email (Resend). Để trống để tắt email.
RESEND_API_KEY=""
MAIL_FROM="ScratchKids <no-reply@your-domain.com>"
NOTIFY_EMAIL=""

# Bí mật cho cron báo cáo tuần.
CRON_SECRET=""

# Hiển thị trên website
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_ZALO=""
NEXT_PUBLIC_HERO_VIDEO_EMBED=""
